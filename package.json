{
  "name": "agent-atrium",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A 3D agent office and workspace for your coding agents: Claude Code, Codex, VS Code, Cursor and OpenCode sessions as bots at their desks in a glass office.",
  "homepage": "https://github.com/Venutian/agent-atrium#readme",
  "license": "MIT",
  "author": "Yoel Mebrahtu",
  "contributors": [
    "Jarren Rocks (Bot Crossing, the original project)"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Venutian/agent-atrium.git"
  },
  "bugs": {
    "url": "https://github.com/Venutian/agent-atrium/issues"
  },
  "keywords": [
    "claude-code",
    "codex",
    "cursor",
    "opencode",
    "vscode",
    "coding-agent",
    "ai-agents",
    "multi-agent",
    "agent-workspace",
    "agent-office",
    "virtual-office",
    "agent-dashboard",
    "agent-monitor",
    "three.js",
    "webgl",
    "3d",
    "developer-tools",
    "visualization",
    "local-first"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "os": [
    "darwin",
    "win32",
    "linux"
  ],
  "scripts": {
    "dev": "npm run assets --silent && vite",
    "build": "npm run assets --silent && vite build",
    "start": "npm run build && node server/serve.mjs",
    "serve": "node server/serve.mjs",
    "demo": "npm run build && node server/serve.mjs --demo",
    "assets": "node tools/build-assets.mjs",
    "test": "node --test \"test/**/*.test.mjs\""
  },
  "dependencies": {
    "three": "^0.185.0"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.4.2",
    "@gltf-transform/functions": "^4.4.2",
    "vite": "^7.1.0"
  }
}
